# 页面标题
VITE_APP_TITLE = 潮声

# 环境配置：development 或 production
VITE_APP_ENV = 'development'

# API 代理路径
VITE_APP_BASE_API = '/tides-dev'

# 后端地址
VITE_APP_URL = 'http://127.0.0.1:6085'
VITE_PROGRAM_APP_URL = 'http://127.0.0.1:6086'

# 是否签名调用（0: 不签名普通调用，1: 签名调用）
VITE_SIGN_FLAG = 0

# 平台 code 码
VITE_CODE = '0001'

# 签名私钥，请使用本地真实值，不要提交到 Git
VITE_SIGN_SECRET_KEY = 'replace-with-your-private-key'

# 使用生成订单调用的版本方式（值选择为 1 到 4，4 为异步方式）
VITE_CREATE_ORDER_VERSION = 4

# 注册改成点击获取体验账号
VITE_EXPERIENCE_ACCOUNT_FLAG = 0
